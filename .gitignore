# Ignore data by default; project data folders are explicitly included below
/data/**
!/data/raw/
!/data/raw/.gitkeep
!/data/processed/
!/data/processed/.gitkeep
*.mlg
*.msl
*.msq

# Local course handouts and reference material
/course-materials/
/references/private/

# Python environments and caches
.venv/
venv/
env/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
/build/
/dist/

# Local configuration and credentials
.env
.env.*
!.env.example
*.pem
*.key

# Generated local models and exports
# Excel lock files (the workbook itself is not matched by this rule)
/models/
/reports/private/
*.log
*.zip

# Editor and operating-system files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Keep project datasets in version control.
# These exceptions must remain after the general ignore rules above.
!/data/csv/
!/data/csv/**
!/data/raw/**
!/data/processed/**
!/data/calibration/
!/data/calibration/**
!/data/synthetic/
!/data/synthetic/**
!/data/xlsx/**

# Never add temporary Excel lock files, even inside included data folders.
~$*.xlsx
